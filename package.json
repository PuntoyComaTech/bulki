{
	"name": "@puntoycoma/bulki",
	"version": "2.0.0",
	"description": "Ultra-fast CLI image optimizer with interactive TUI, MCP server for AI editors, git hooks, watch mode, and piping. Compress, resize, and convert JPEG, PNG, WebP, GIF, AVIF in bulk. Free and open source.",
	"keywords": [
		"image",
		"optimizer",
		"compress",
		"resize",
		"convert",
		"webp",
		"avif",
		"png",
		"jpeg",
		"gif",
		"sharp",
		"cli",
		"bulk",
		"batch",
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"claude-code",
		"cursor",
		"ai-tools",
		"git-hook",
		"pre-commit",
		"watch",
		"stdin",
		"pipe",
		"interactive",
		"tui",
		"free",
		"open-source",
		"image-compression",
		"image-optimization",
		"image-processing"
	],
	"author": "Gabriel Rubio",
	"license": "MIT",
	"type": "module",
	"bin": {
		"bulki": "./dist/bin/bulki.js",
		"gio": "./dist/bin/bulki.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"prepublishOnly": "npm run lint && npm run test && npm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"commander": "^13.0.0",
		"sharp": "^0.34.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"execa": "^9.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuntoyComaTech/bulki.git"
	},
	"bugs": {
		"url": "https://github.com/PuntoyComaTech/bulki/issues"
	},
	"homepage": "https://github.com/PuntoyComaTech/bulki#readme"
}
